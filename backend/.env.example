# Copy this file to ".env" (same folder) and fill in real values.
# The ".env" file must NOT be committed to git or placed inside public/.

# MySQL — from cPanel > MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# A long random string used to sign login tokens. Generate one with:
# php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_DAYS=30

# Used only for building links/emails, not for routing.
APP_URL=https://api.combust.slowatcoding.com
FRONTEND_URL=https://combust.slowatcoding.com

# The "From" address for OTP emails. Must be a real mailbox on your domain
# (e.g. create one in cPanel > Email Accounts) for best deliverability.
MAIL_FROM=noreply@combust.slowatcoding.com
MAIL_FROM_NAME=Combust
